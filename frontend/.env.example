# Copy to .env.local and fill in.

# FastAPI backend (Agent A). Server-side only - never exposed to the browser.
BACKEND_URL=http://localhost:8000

# Finnhub real-time trade feed. Read by server.mjs and used only by the relay,
# so the key never reaches the client. Free key: https://finnhub.io/register
# Without it the app still runs; the live tick indicator reports "unconfigured".
FINNHUB_API_KEY=
