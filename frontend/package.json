{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript ${BACKEND_URL:-http://localhost:8000}/openapi.json -o src/lib/api/schema.d.ts",
    "gen:types:offline": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.4",
    "lightweight-charts": "^5.2.1",
    "next": "16.3.4",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
